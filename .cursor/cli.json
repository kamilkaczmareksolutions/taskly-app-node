{
  "permissions": {
    "allow": [
      "Read(backend/**)",
      "Read(frontend/src/**)",
      "Read(.cursor/**)",
      "Read(scripts/agent/**)",
      "Read(changed-files.json)",
      "Read(SOLUTION.md)",
      "Write(backend/tests/**)",
