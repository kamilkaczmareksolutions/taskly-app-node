      "Shell(gh)",
      "Shell(gh:*)",
      "Shell(curl)",
      "Shell(curl:*)",
      "Shell(wget)",
      "Shell(wget:*)",
      "Shell(npm)",
      "Shell(npm:*)",
      "Shell(npx)",
      "Shell(npx:*)",
      "Shell(rm)",
      "Shell(rm:*)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(**/package.json)",
      "Write(**/package-lock.json)",
      "Write(.github/**)",
      "Write(.cursor/**)",
      "Write(scripts/**)",
      "Write(**/.env*)",
      "Write(.env*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/node_modules/**)",
      "Read(.git/**)",
      "Read(**/coverage/**)",
      "Read(**/dist/**)",
      "Read(.github/**)",
      "WebFetch(*)",
      "Mcp(*:*)"
    ]
  }
}
